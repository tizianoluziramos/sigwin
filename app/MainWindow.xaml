<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="signal_windows_client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sigwin">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF241F3A" Offset="0"/>
                    <GradientStop Color="#FF2E2A55" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <TextBlock Text="Sigwin" Foreground="#CCFFFFFF" FontSize="12"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1"/>
    </Grid>
</Window>
