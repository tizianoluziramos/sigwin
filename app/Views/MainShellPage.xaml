<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="signal_windows_client.Views.MainShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:signal_windows_client.Models"
    xmlns:converters="using:signal_windows_client.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:VideoPathToMediaSourceConverter x:Key="VideoPathConverter"/>

        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Left icon rail ===== -->
        <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorAltBrush}">
            <StackPanel VerticalAlignment="Top" Margin="0,10,0,0" Spacing="4">
                <Button Style="{StaticResource RailButton}" ToolTipService.ToolTip="Chats" IsEnabled="False">
                    <FontIcon Glyph="&#xE8BD;"/>
                </Button>
                <Button Style="{StaticResource RailButton}" ToolTipService.ToolTip="Calls">
                    <FontIcon Glyph="&#xE717;"/>
                </Button>
                <Button Style="{StaticResource RailButton}" ToolTipService.ToolTip="Linked devices">
                    <FontIcon Glyph="&#xE8CC;"/>
                </Button>
            </StackPanel>
            <Button Style="{StaticResource RailButton}" VerticalAlignment="Bottom" Margin="0,0,0,10"
                    ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;"/>
                <Button.Flyout>
                    <MenuFlyout Placement="RightEdgeAlignedBottom">
                        <MenuFlyoutItem Text="Log out (unlink device)" Click="OnLogOut"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- ===== Chats list pane ===== -->
        <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,14,12,6">
                <TextBlock Text="Chats" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                    <Button Style="{StaticResource RailButton}" ToolTipService.ToolTip="New chat">
                        <FontIcon Glyph="&#xE932;" FontSize="16"/>
                    </Button>
                    <Button Style="{StaticResource RailButton}" ToolTipService.ToolTip="More">
                        <FontIcon Glyph="&#xE712;" FontSize="16"/>
                    </Button>
                </StackPanel>
            </Grid>

            <AutoSuggestBox Grid.Row="1" Margin="12,4,12,8" PlaceholderText="Search" QueryIcon="Find"/>

            <ListView Grid.Row="2"
                      ItemsSource="{x:Bind Vm.Conversations, Mode=OneWay}"
                      SelectedItem="{x:Bind Vm.SelectedConversation, Mode=TwoWay}"
                      SelectionMode="Single" Padding="4,0">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection/>
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Margin" Value="4,2"/>
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Conversation">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="44" Height="44">
                                <Border CornerRadius="22" Background="{x:Bind AvatarBrush}"
                                        Visibility="{x:Bind InitialsVisibility, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Initials}" Foreground="White" FontSize="16"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border CornerRadius="22" Visibility="{x:Bind AvatarVisibility, Mode=OneWay}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{x:Bind Avatar, Mode=OneWay}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="8" Width="16" Height="16" Background="#3A3560"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Visibility="{x:Bind GroupBadgeVisibility, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE716;" FontSize="10" Foreground="White"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind LastPreview, Mode=OneWay}" Opacity="0.6"
                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind LastTimeDisplay, Mode=OneWay}" Opacity="0.5"
                                       FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ===== Conversation pane ===== -->
        <Grid Grid.Column="2">
            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind VisInv(Vm.HasSelection), Mode=OneWay}">
                <TextBlock Text="Sigwin" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0.9"/>
                <TextBlock Text="Select a chat to start messaging" Opacity="0.5" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Active conversation -->
            <Grid Visibility="{x:Bind Vis(Vm.HasSelection), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="16,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36">
                            <Border CornerRadius="18" Background="{x:Bind Vm.SelectedConversation.AvatarBrush, Mode=OneWay}"
                                    Visibility="{x:Bind Vm.SelectedConversation.InitialsVisibility, Mode=OneWay}">
                                <TextBlock Text="{x:Bind Vm.SelectedConversation.Initials, Mode=OneWay}"
                                           Foreground="White" FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="18" Visibility="{x:Bind Vm.SelectedConversation.AvatarVisibility, Mode=OneWay}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{x:Bind Vm.SelectedConversation.Avatar, Mode=OneWay}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="{x:Bind Vm.SelectedConversation.Title, Mode=OneWay}"
                                       FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind Vm.SelectedConversation.HeaderSubtitle, Mode=OneWay}"
                                       Visibility="{x:Bind Vm.SelectedConversation.TypingVisibility, Mode=OneWay}"
                                       FontSize="12" Foreground="{ThemeResource SystemAccentColor}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <Button Style="{StaticResource RailButton}" ToolTipService.ToolTip="Video call">
                                <FontIcon Glyph="&#xE714;" FontSize="16"/>
                            </Button>
                            <Button Style="{StaticResource RailButton}" ToolTipService.ToolTip="Voice call">
                                <FontIcon Glyph="&#xE717;" FontSize="16"/>
                            </Button>
                            <Button Style="{StaticResource RailButton}" ToolTipService.ToolTip="Search">
                                <FontIcon Glyph="&#xE721;" FontSize="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Messages -->
                <ListView x:Name="MessagesList" Grid.Row="1"
                          ItemsSource="{x:Bind Vm.SelectedConversation.Messages, Mode=OneWay}"
                          Padding="16,10" SelectionMode="None">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection/>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatMessage">
                            <StackPanel HorizontalAlignment="{x:Bind Alignment}" Spacing="2" MaxWidth="460">
                                <Border Background="{x:Bind BubbleBrush}" CornerRadius="14" Padding="12,8">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Reply" Tag="{x:Bind}" Click="OnReplyClick"/>
                                            <MenuFlyoutItem Text="Copy text" Tag="{x:Bind}" Click="OnCopyClick"/>
                                            <MenuFlyoutSubItem Text="React">
                                                <MenuFlyoutItem Text="👍" Tag="{x:Bind}" Click="OnReactClick"/>
                                                <MenuFlyoutItem Text="❤️" Tag="{x:Bind}" Click="OnReactClick"/>
                                                <MenuFlyoutItem Text="😂" Tag="{x:Bind}" Click="OnReactClick"/>
                                                <MenuFlyoutItem Text="😮" Tag="{x:Bind}" Click="OnReactClick"/>
                                                <MenuFlyoutItem Text="😢" Tag="{x:Bind}" Click="OnReactClick"/>
                                                <MenuFlyoutItem Text="🙏" Tag="{x:Bind}" Click="OnReactClick"/>
                                            </MenuFlyoutSubItem>
                                            <MenuFlyoutItem Text="Delete for everyone" Tag="{x:Bind}" Click="OnDeleteClick"
                                                             Visibility="{x:Bind DeleteMenuVisibility, Mode=OneWay}"/>
                                        </MenuFlyout>
                                    </Border.ContextFlyout>

                                    <StackPanel Spacing="3">
                                        <!-- Quoted reply snippet -->
                                        <Border Background="#22FFFFFF" BorderBrush="{ThemeResource SystemAccentColor}"
                                                BorderThickness="3,0,0,0" CornerRadius="6" Padding="8,4" Margin="0,0,0,2"
                                                Visibility="{x:Bind QuoteVisibility, Mode=OneWay}">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind Quote.AuthorDisplay}" FontSize="11"
                                                           FontWeight="SemiBold" Opacity="0.85" Foreground="White"/>
                                                <TextBlock Text="{x:Bind Quote.Text}" FontSize="12" Opacity="0.75"
                                                           TextTrimming="CharacterEllipsis" MaxLines="2" Foreground="White"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Deleted tombstone -->
                                        <TextBlock Text="{x:Bind DeletedDisplay}" FontStyle="Italic" Opacity="0.6"
                                                   Foreground="White" Visibility="{x:Bind DeletedVisibility, Mode=OneWay}"/>

                                        <!-- Attachments (image/video inline, other files as a chip) -->
                                        <ItemsControl ItemsSource="{x:Bind Attachments}"
                                                      Visibility="{x:Bind AttachmentVisibility, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:AttachmentItem">
                                                    <Grid Margin="0,0,0,4" CornerRadius="8">
                                                        <Border CornerRadius="8" Background="#22FFFFFF" Height="120" Width="200"
                                                                Visibility="{x:Bind LoadingVisibility, Mode=OneWay}">
                                                            <ProgressRing IsActive="True" Width="24" Height="24"/>
                                                        </Border>
                                                        <Image Source="{x:Bind Image, Mode=OneWay}"
                                                               Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
                                                               MaxWidth="320" MaxHeight="320" Stretch="Uniform"/>
                                                        <MediaPlayerElement
                                                            Source="{x:Bind VideoPath, Mode=OneWay, Converter={StaticResource VideoPathConverter}}"
                                                            Visibility="{x:Bind VideoVisibility, Mode=OneWay}"
                                                            AreTransportControlsEnabled="True"
                                                            MaxWidth="320" MaxHeight="320"/>
                                                        <Border Background="#22FFFFFF" CornerRadius="8" Padding="8"
                                                                Visibility="{x:Bind FileVisibility, Mode=OneWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE8A5;" FontSize="20" Foreground="White"/>
                                                                <StackPanel>
                                                                    <TextBlock Text="{x:Bind DisplayName}" FontSize="13" Foreground="White"/>
                                                                    <TextBlock Text="{x:Bind SizeDisplay}" FontSize="11" Opacity="0.6" Foreground="White"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{x:Bind Body, Mode=OneWay}" TextWrapping="Wrap" Foreground="White"
                                                   Visibility="{x:Bind BodyVisibility, Mode=OneWay}"/>

                                        <!-- Link preview card -->
                                        <Border Background="#22FFFFFF" CornerRadius="8" Margin="0,4,0,0"
                                                Visibility="{x:Bind PreviewVisibility, Mode=OneWay}">
                                            <StackPanel>
                                                <Image Source="{x:Bind Preview.Image, Mode=OneWay}"
                                                       Visibility="{x:Bind Preview.ImageVisibility, Mode=OneWay}"
                                                       MaxHeight="160" Stretch="UniformToFill"/>
                                                <StackPanel Padding="8" Spacing="2">
                                                    <TextBlock Text="{x:Bind Preview.Title}" FontWeight="SemiBold" FontSize="13"
                                                               Foreground="White" Visibility="{x:Bind Preview.HasTitle}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind Preview.Description}" FontSize="12" Opacity="0.7"
                                                               Foreground="White" Visibility="{x:Bind Preview.HasDescription}"
                                                               TextTrimming="CharacterEllipsis" MaxLines="2"/>
                                                    <TextBlock Text="{x:Bind Preview.Url}" FontSize="11" Opacity="0.5"
                                                               Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                            <TextBlock Text="(edited)" FontSize="10" Opacity="0.5" Foreground="White"
                                                       Visibility="{x:Bind EditedVisibility, Mode=OneWay}"/>
                                            <TextBlock Text="{x:Bind TimeDisplay}" Opacity="0.55" FontSize="11" Foreground="White"/>
                                            <TextBlock Text="{x:Bind ReceiptGlyph, Mode=OneWay}" Opacity="0.7" FontSize="11"
                                                       Foreground="White" Visibility="{x:Bind ReceiptVisibility, Mode=OneWay}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Reactions -->
                                <ItemsControl ItemsSource="{x:Bind Reactions}" HorizontalAlignment="{x:Bind Alignment}"
                                              Visibility="{x:Bind ReactionsVisibility, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ReactionItem">
                                            <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="10" Padding="6,2">
                                                <TextBlock Text="{x:Bind Display, Mode=OneWay}" FontSize="12"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Reply banner -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="12,8"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        Visibility="{x:Bind Vis(Vm.HasReply), Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7A0;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}"/>
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Text="Replying" FontSize="11" Opacity="0.6"/>
                            <TextBlock Text="{x:Bind Vm.ReplyingTo.Body, Mode=OneWay}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource RailButton}" Width="28" Height="28"
                                Click="OnCancelReplyClick" ToolTipService.ToolTip="Cancel reply">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Composer -->
                <Border Grid.Row="3" BorderThickness="0,1,0,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="12,10"
                        AllowDrop="True" DragOver="OnComposerDragOver" Drop="OnComposerDrop">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource RailButton}" IsEnabled="False"
                                ToolTipService.ToolTip="Emoji (coming soon)">
                            <FontIcon Glyph="&#xE76E;" FontSize="16"/>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource RailButton}" Click="OnAttachClick"
                                ToolTipService.ToolTip="Attach image or video">
                            <FontIcon Glyph="&#xE710;" FontSize="16"/>
                        </Button>
                        <TextBox Grid.Column="2" x:Name="Composer"
                                 Text="{x:Bind Vm.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Message" CornerRadius="18" Padding="12,8"
                                 Background="#2A2745"
                                 VerticalAlignment="Center" KeyDown="OnComposerKeyDown" Paste="OnComposerPaste">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackground" Color="#2A2745"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2745"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2A2745"/>
                            </TextBox.Resources>
                        </TextBox>
                        <Button Grid.Column="3" Style="{StaticResource RailButton}" Click="OnSend"
                                ToolTipService.ToolTip="Send">
                            <FontIcon Glyph="&#xE724;" FontSize="16"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
