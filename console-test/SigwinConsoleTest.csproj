<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The native core is x64; force a 64-bit process so it can load. -->
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>SigwinConsoleTest</AssemblyName>
    <RootNamespace>SigwinConsoleTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by the Rust build (csbindgen). Build core/ first. -->
    <Compile Include="..\bindings\NativeMethods.g.cs" />
  </ItemGroup>

  <!-- Copy the native DLLs next to the test exe so it can load them at runtime.
       sigwin_core.dll dynamically depends on OpenSSL's libcrypto, which we take
       from the vcpkg install via the OPENSSL_DIR environment variable. -->
  <Target Name="CopyNativeDlls" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\core\target\debug\sigwin_core.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)\..\core\target\debug\sigwin_core.dll')" />
    <Copy SourceFiles="$(OPENSSL_DIR)\bin\libcrypto-3-x64.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="'$(OPENSSL_DIR)' != '' And Exists('$(OPENSSL_DIR)\bin\libcrypto-3-x64.dll')" />
  </Target>

</Project>
